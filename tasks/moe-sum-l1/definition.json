{
  "id": "moe-sum-l1",
  "kind": "kernel",
  "family": "moe",
  "tier": "L1",
  "precision": ["bfloat16"],
  "axes": {
    "M": {"type": "var", "domain": {"values": [8192, 13312]}},
    "K": {"type": "const", "value": 8},
    "H": {"type": "const", "value": 2048}
  },
  "inputs": {
    "expert_out": {"shape": ["M", "K", "H"], "dtype": "bfloat16"}
  },
  "outputs": {
    "out": {"shape": ["M", "H"], "dtype": "bfloat16"}
  },
  "tolerance": {"rtol": 0.02, "atol": 0.01},
  "reference": "reference.py",
  "dcu": {
    "peak_constant": "peak_achievable:copy",
    "roofline_bandwidth": "peak_achievable:copy",
    "work": "M*K*H*2 + M*H*2",
    "work_unit": "byte",
    "min_l2_flush_mb": 16,
    "needs_gpu": true,
    "baseline_impl": "harness.implementations.aiter_moe_sum"
  }
}
