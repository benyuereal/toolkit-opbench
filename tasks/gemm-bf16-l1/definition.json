{
  "id": "gemm-bf16-l1",
  "kind": "kernel",
  "family": "gemm",
  "tier": "L1",
  "precision": ["bfloat16"],
  "axes": {
    "M": {"type": "var", "domain": {"values": [4096, 8192, 13312]}},
    "N": {"type": "const", "value": 4096},
    "K": {"type": "const", "value": 4096}
  },
  "inputs": {
    "A": {"shape": ["M", "K"], "dtype": "bfloat16"},
    "B": {"shape": ["K", "N"], "dtype": "bfloat16"}
  },
  "outputs": {
    "C": {"shape": ["M", "N"], "dtype": "bfloat16"}
  },
  "tolerance": {"rtol": 0.02, "atol": 0.01},
  "reference": "reference.py",
  "dcu": {
    "peak_constant": "peak_achievable:bf16",
    "baseline_impl": "torch.mm",
    "work": "2*M*N*K",
    "work_unit": "flop",
    "min_l2_flush_mb": 16,
    "needs_gpu": true
  }
}
